[Unit]
Description=WiFi Access Point Network
BindsTo=hostapd.service
After=hostapd.service

[Service]
Type=forking
PIDFile=/run/dnsmasq-ap.pid
ExecStartPre=-/sbin/ip addr add 10.10.10.1/24 dev uap0
ExecStartPre=/sbin/sysctl -qw net.ipv4.ip_forward=1
ExecStart=/usr/bin/dnsmasq -x /run/dnsmasq-ap.pid -C /etc/hostapd-dhcp.conf
ExecStartPost=/usr/sbin/iptables -t nat -A POSTROUTING -s 10.10.10.0/24 ! -d 10.10.10.0/24 -j MASQUERADE
ExecStopPost=-/usr/sbin/iptables -t nat -D POSTROUTING -s 10.10.10.0/24 ! -d 10.10.10.0/24 -j MASQUERADE

[Install]
WantedBy=multi-user.target
