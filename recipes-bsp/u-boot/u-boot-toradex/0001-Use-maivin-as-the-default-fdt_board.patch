From a6af1457aba103b9ce4fad18583e1008cbdf9053 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?S=C3=A9bastien=20Taylor?= <sebastien@au-zone.com>
Date: Wed, 26 Oct 2022 15:54:20 +0000
Subject: [PATCH] Use maivin as the default fdt_board.

Upstream-Status: Inappropriate [board-specific configuration]
---
 include/configs/verdin-imx8mp.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/configs/verdin-imx8mp.h b/include/configs/verdin-imx8mp.h
index 0b88e95603d..7adddf8c7f3 100644
--- a/include/configs/verdin-imx8mp.h
+++ b/include/configs/verdin-imx8mp.h
@@ -41,7 +41,7 @@
 	MEM_LAYOUT_ENV_SETTINGS \
 	"boot_script_dhcp=boot.scr\0" \
 	"console=ttymxc2\0" \
-	"fdt_board=dev\0" \
+	"fdt_board=maivin\0" \
 	"initrd_addr=0x43800000\0" \
 	"initrd_high=0xffffffffffffffff\0" \
 	"update_uboot=askenv confirm Did you load flash.bin (y/N)?; " \
