--- a/imx/start_isp.sh
+++ b/imx/start_isp.sh
@@ -6,7 +6,45 @@
 # (c) NXP 2020-2022
 #
 
-RUNTIME_DIR="$( cd "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
+ORIG_DIR="$( cd "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
+
+# Maivin: this install directory (${libdir}/imx8-isp) is part of the
+# OSTree-versioned, read-only /usr tree -- but run.sh writes its generated
+# OS08A20_MODES.txt/DAA3840_MODES.txt/Sensor{0,1}_Entry.cfg files relative
+# to its own directory ($(dirname $0)), which fails outright there
+# ("Read-only file system"). Mirror the install directory into a writable
+# tmpfs via symlinks and invoke run.sh from there instead: run.sh resolves
+# its own path with "realpath -s" (deliberately not following symlinks),
+# so it treats this writable mirror as its own directory for writes while
+# still finding the real static assets through the symlinks. run.sh
+# itself is unmodified by this -- only where it's invoked from changes.
+RUNTIME_DIR=/run/imx8-isp
+rm -rf "$RUNTIME_DIR"
+mkdir -p "$RUNTIME_DIR/dewarp_config"
+for f in "$ORIG_DIR"/*; do
+	[ -f "$f" ] && ln -sf "$f" "$RUNTIME_DIR/$(basename "$f")"
+done
+for f in "$ORIG_DIR"/dewarp_config/*; do
+	ln -sf "$f" "$RUNTIME_DIR/dewarp_config/$(basename "$f")"
+done
+
+# Maivin: every "exec ./run.sh ... -lm" below has had -lm stripped (both
+# here and in the original device-tree-detection branches further down).
+# Our vvcam/os08a20 kernel modules are already loaded at boot (softdep in
+# imx8_media_dev.conf) and in active use, so run.sh's own rmmod/insmod
+# reload cycle fails -- rmmod can't remove an in-use module -- and
+# load_modules() exits 1 immediately, which happens on every single
+# start/restart, including the very first boot.
+#
+# Maivin: skip device-tree auto-detection entirely when ISP_CONFIG is set
+# (e.g. via /etc/default/isp), so a caller can pick an explicit run.sh
+# configuration -- see run.sh -c for the full list.
+if [ -n "$ISP_CONFIG" ]; then
+	echo "Starting isp_media_server with configuration override \"$ISP_CONFIG\""
+	cd $RUNTIME_DIR
+	exec ./run.sh -c "$ISP_CONFIG"
+fi
+
 NR_DEVICE_TREE_BASLER=$(grep basler-camera-vvcam `find /sys/firmware/devicetree/base/soc@0/ -name compatible | grep i2c` -l | wc -l 2> /dev/null)
 NR_DEVICE_TREE_OV5640=$(grep ov5640 `find /sys/firmware/devicetree/base/soc@0/ -name compatible | grep i2c` -l | wc -l 2> /dev/null)
 NR_DEVICE_TREE_OS08A20=$(grep os08a20 `find /sys/firmware/devicetree/base/soc@0/ -name compatible | grep i2c` -l | wc -l 2> /dev/null)
@@ -23,13 +61,13 @@
 
 		# Default configuration for Basler daA3840-30mc: basler_4k
 		# Available configurations: basler_4k, basler_1080p60, basler_4khdr, basler_1080p60hdr
-		exec ./run.sh -c basler_4k -lm
+		exec ./run.sh -c basler_4k
 
 	elif [ $NR_DEVICE_TREE_OV5640 -eq 1 ]; then
 
 		# Default configuration for Basler daA3840-30mc: basler_1080p60
 		# Available configurations: basler_1080p60, basler_1080p60hdr
-		exec ./run.sh -c basler_1080p60 -lm
+		exec ./run.sh -c basler_1080p60
 	fi
 
 elif [ $NR_DEVICE_TREE_BASLER -eq 2 ]; then
@@ -39,7 +77,7 @@
 	cd $RUNTIME_DIR
 	# Default configuration for Basler daA3840-30mc: dual_basler_1080p60
 	# Available configurations: dual_basler_1080p60, dual_basler_1080p60hdr
-	exec ./run.sh -c dual_basler_1080p60 -lm
+	exec ./run.sh -c dual_basler_1080p60
 # check if the os08a20 device has been enabled in the device tree
 elif [ $NR_DEVICE_TREE_OS08A20 -eq 1 ]; then
 
@@ -51,13 +89,13 @@
 
 		# Default configuration for Os08a20: Os08a20_4k
 		# Available configurations: Os08a20_4k, Os08a20_1080p60, Os08a20_4khdr, Os08a20_1080p30hdr
-		exec ./run.sh -c os08a20_4k -lm
+		exec ./run.sh -c os08a20_4k
 
 	elif [ $NR_DEVICE_TREE_OV5640 -eq 1 ]; then
 
 		# Default configuration for Os08a20: Os08a20_1080p60
 		# Available configurations: Os08a20_1080p60, Os08a20_1080p30hdr
-		exec ./run.sh -c os08a20_1080p60 -lm
+		exec ./run.sh -c os08a20_1080p60
 	fi
 
 elif [ $NR_DEVICE_TREE_OS08A20 -eq 2 ]; then
@@ -67,7 +105,7 @@
 	cd $RUNTIME_DIR
 	# Default configuration for Os08a20: dual_Os08a20_1080p60
 	# Available configurations: dual_Os08a20_1080p60, dual_Os08a20_1080p30hdr
-	exec ./run.sh -c dual_os08a20_1080p60 -lm
+	exec ./run.sh -c dual_os08a20_1080p60
 
 else
