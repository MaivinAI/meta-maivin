--- a/imx/imx8-isp.service
+++ b/imx/imx8-isp.service
@@ -9,9 +9,13 @@
 [Service]
 Restart=on-failure
 RestartSec=5s
-# ENXIO            
+# ENXIO
 #RestartPreventExitStatus=6
-ExecStart=/opt/imx8-isp/bin/start_isp.sh
+# Maivin: optional ISP_CONFIG override, honoured by start_isp.sh, lets a
+# caller (see maivin-camera-select-mode) pick an explicit run.sh
+# configuration instead of start_isp.sh's own device-tree auto-detection.
+EnvironmentFile=-/etc/default/isp
+ExecStart=/usr/lib/imx8-isp/start_isp.sh
 
 [Install]
 WantedBy=multi-user.target
