[Unit]
Description=Maivin Camera Service
After=imx8-isp.service network.target
Wants=imx8-isp.service network.target
Before=recorder.service
# Bound the restart loop. Restart=always with systemd's defaults (100ms
# RestartSec, a 10s StartLimitIntervalSec) can never trip the limiter --
# one start cycle, ExecStartPre plus the device-open attempt, already
# outlasts the window -- so a camera that cannot open the device restarts
# forever at ~100ms intervals. Past a few attempts the unit belongs in
# "failed", where it is visible, instead of hammering the ISP. EDGEAI-1403.
#
# Sizing rule: StartLimitBurst * cycle must fit inside
# StartLimitIntervalSec. systemd permits StartLimitBurst starts within the
# window and refuses the next one, so the refusal only ever happens if the
# whole run of them lands inside a single window. A window shorter than
# that resets the count before it can be reached and the unit restarts
# forever -- quietly reintroducing the exact failure this setting exists to
# prevent. Getting this wrong is invisible until a device is already stuck
# in the loop, so re-check the arithmetic when any timeout below changes.
#
# Cycle time is set by whichever startup step fails:
#   ~25s  edgefirst-camera cannot open the device. Since camera 2.10.0 it
#         retries in-process while the vvcam driver reports EAGAIN -- the
#         ISP is running but not yet serving. Measured at 10s: the open is
#         rejected immediately, so the 6-attempt cap ends the loop well
#         before its 15s budget. Plus ExecStartPre and RestartSec below.
#   ~67s  maivin-camera-wait-ready exhausts MAX_TRIES=60 and fails.
#    70s  maivin-camera-select-mode gives up on a restart imx8-isp.service
#         keeps refusing (ISP_RESTART_MAX_WAIT=65) and fails. Measured
#         exactly: 65s of retries plus RestartSec.
# The slowest is 70s and 5 * 70s = 350s. 360s covers that but only by 10s,
# and the failure mode of being one second short is silent -- the counter
# resets and the unit restarts forever. A wider window only ever makes the
# refusal more likely, so the margin is nearly free; the only cost is that
# an operator's own repeated `systemctl restart camera` hits the burst
# sooner. 420s buys a full extra cycle of slack for one more minute of
# that. Verified on develop #122: the unit reached "failed" at 361s with a
# 360s window, so the arithmetic is real, not theoretical.
#
# Two cases are deliberately left uncovered, both slow ExecStartPre paths
# that log their own failure, unlike the silent fast restart loop this
# limiter exists for. Covering either needs a window long enough to start
# refusing an operator's own `systemctl restart camera`, which counts
# toward the burst like any other start.
#   ~130s the two ExecStartPre steps are sequential, so their times add:
#         select-mode retrying a refused ISP restart for nearly its full
#         65s and then succeeding, followed by wait-ready exhausting its
#         own 60s. Under TimeoutStartSec below, so it runs to completion.
#         Needs ~660s.
#   ~185s TimeoutStartSec below fires on the ExecStartPre chain. Needs
#         ~925s. SIGTERMs the chain mid-recovery and systemd logs it.
StartLimitIntervalSec=420
StartLimitBurst=5

[Service]
Type=simple
User=root
# maivin-camera-select-mode can now block up to ~65s riding out
# imx8-isp.service's own StartLimitIntervalSec when its restart is
# rejected, and maivin-camera-wait-ready's own poll loop can take up to
# ~60s on top of that. Both are comfortably past systemd's 90s
# DefaultTimeoutStartSec, which would otherwise SIGTERM the ExecStartPre
# chain mid-recovery instead of letting it finish.
TimeoutStartSec=180
ExecStartPre=/usr/bin/maivin-camera-select-mode
ExecStartPre=/usr/bin/maivin-camera-wait-ready
ExecStart=/usr/bin/edgefirst-camera
EnvironmentFile=/etc/default/camera
# Written by maivin-camera-select-mode (ExecStartPre above) for the
# CAMERA_MODE actually resolved this start; overrides CAM_INFO_PATH from
# /etc/default/camera above. Optional ("-" prefix) since it doesn't exist
# until the first ExecStartPre has run.
EnvironmentFile=-/etc/default/isp
Restart=always
# A term in the cycle time the StartLimit arithmetic above depends on, so
# changing this means re-checking that sizing. Also slow enough that a
# restart does not re-enter maivin-camera-select-mode before the previous
# ISP start has settled.
RestartSec=5s

[Install]
WantedBy=maivin.target
