[Unit]
Description=Maivin Camera Service
After=imx8-isp.service network.target
Wants=imx8-isp.service network.target
Before=recorder.service
# Bound the restart loop. Restart=always with systemd's defaults (100ms
# RestartSec, a 10s StartLimitIntervalSec) can never trip the limiter --
# one start cycle, ExecStartPre plus the device-open attempt, already
# outlasts the window -- so a camera that cannot open the device restarts
# forever at ~100ms intervals. Five attempts inside a minute rides out a
# transient ISP reload; past that the unit belongs in "failed", where it is
# visible, instead of hammering the ISP. EDGEAI-1403.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
# maivin-camera-select-mode can now block up to ~65s riding out
# imx8-isp.service's own StartLimitIntervalSec when its restart is
# rejected, and maivin-camera-wait-ready's own poll loop can take up to
# ~60s on top of that. Both are comfortably past systemd's 90s
# DefaultTimeoutStartSec, which would otherwise SIGTERM the ExecStartPre
# chain mid-recovery instead of letting it finish.
TimeoutStartSec=180
ExecStartPre=/usr/bin/maivin-camera-select-mode
ExecStartPre=/usr/bin/maivin-camera-wait-ready
ExecStart=/usr/bin/edgefirst-camera
EnvironmentFile=/etc/default/camera
# Written by maivin-camera-select-mode (ExecStartPre above) for the
# CAMERA_MODE actually resolved this start; overrides CAM_INFO_PATH from
# /etc/default/camera above. Optional ("-" prefix) since it doesn't exist
# until the first ExecStartPre has run.
EnvironmentFile=-/etc/default/isp
Restart=always
# Paired with StartLimitIntervalSec/StartLimitBurst above: slow enough that
# five failures fit inside the limiter's window, and that a restart does
# not re-enter maivin-camera-select-mode before the previous ISP start has
# settled.
RestartSec=5s

[Install]
WantedBy=maivin.target
