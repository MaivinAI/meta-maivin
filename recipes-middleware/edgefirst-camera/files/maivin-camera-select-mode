#!/bin/sh
# Resolve CAMERA_MODE to an upstream isp-imx run.sh configuration name and
# its matching camera-info calibration path, write both to
# /etc/default/isp, and restart imx8-isp.service so start_isp.sh picks up
# ISP_CONFIG (see meta-maivin's isp-imx bbappend patches for the
# ISP_CONFIG override and the dual_os08a20_4k configuration). camera.service
# also sources /etc/default/isp, after the static /etc/default/camera
# default, so this overrides it.
#
# A non-empty CAM_INFO_PATH in /etc/default/camera overrides the
# CAMERA_MODE-derived default. It's read directly from that one file, in a
# subshell, rather than trusted from this script's own inherited
# environment: systemd applies EnvironmentFile= to every Exec* in this
# unit's activation including this ExecStartPre, so plain $CAM_INFO_PATH
# here would be last boot's auto-resolved value from /etc/default/isp
# (which wins the merge) rather than the administrator's setting -- masking
# a real override, and never re-resolving on a later CAMERA_MODE switch.
set -eu

USER_CAM_INFO_PATH=""
if [ -r /etc/default/camera ]; then
    USER_CAM_INFO_PATH=$(. /etc/default/camera; echo "${CAM_INFO_PATH:-}")
fi

. /usr/lib/maivin/camera-mode.sh
resolve_camera_mode

# CAM_INFO_PATH resolution, in order of preference:
#   1. a readable administrator override from /etc/default/camera
#   2. the CAMERA_MODE-derived Maivin calibration
#   3. empty, leaving edgefirst-camera to publish camera/info from its own
#      built-in generic defaults
#
# Steps 2 and 3 exist because an override outlives the file it names.
# /etc/default/camera is persistent configuration that survives an OSTree
# upgrade, so a path that was valid when it was written -- /etc/isp/, once
# populated by the old imx8-isp fork -- becomes a dangling reference on any
# later image, and an unconditional override would pin the service to it
# forever. Falling back here recovers Maivin's own measured calibration
# rather than settling for edgefirst-camera's approximate built-ins, which
# know nothing about this sensor or lens. EDGEAI-1441.
if [ -n "$USER_CAM_INFO_PATH" ]; then
    if [ -r "$USER_CAM_INFO_PATH" ]; then
        CAM_INFO_PATH="$USER_CAM_INFO_PATH"
    else
        echo "maivin-camera-select-mode: CAM_INFO_PATH override '$USER_CAM_INFO_PATH' is not readable; falling back to the $CAMERA_MODE calibration '$CAM_INFO_PATH'" >&2
    fi
fi

if [ -n "$CAM_INFO_PATH" ] && [ ! -r "$CAM_INFO_PATH" ]; then
    echo "maivin-camera-select-mode: calibration '$CAM_INFO_PATH' is missing; camera/info will be published from edgefirst-camera's built-in defaults and is NOT valid for projection or fusion" >&2
    CAM_INFO_PATH=""
fi

{
    echo "ISP_CONFIG=$ISP_CONFIG"
    echo "CAM_INFO_PATH=$CAM_INFO_PATH"
} > /etc/default/isp

# The restart is unconditional, not conditional on ISP_CONFIG having
# changed. isp_media_server reliably serves only one client per lifetime:
# attaching a second client to a session that has already served one
# segfaults it, and camera gets EINVAL from the half-torn-down pipeline --
# EDGEAI-1439's "every second time" symptom. Reproduced on
# verdin-imx8mp-15141091: with this restart made conditional, 3 of 4
# camera restarts against a live ISP killed it with SIGSEGV and failed the
# start. Restarting here guarantees camera is always the ISP's first
# client.
#
# This restart used to feed a crash loop: camera.service is Restart=always
# and this runs as its ExecStartPre, so a camera that could not start
# SIGKILLed isp_media_server every few seconds, leaking vvcam kernel state
# until VIDIOC_S_FMT returned EBUSY for every client and only a reboot
# recovered (19 restarts in ~60s, observed while investigating
# EDGEAI-1439). That is bounded in camera.service instead, by RestartSec
# and a StartLimit that can actually trip -- see EDGEAI-1403. Removing the
# restart itself is not an option until the isp_media_server crash is
# fixed.
systemctl restart imx8-isp.service
