#!/bin/sh
# Idempotent Maivin/Raivin provisioning checks (and optional fixes).
#
# Deliberately no `set -e`: each check_* function records failure via the
# fail()/$FAILED bookkeeping below and returns, sometimes with a non-zero
# status, so every check runs and every failure is reported in one pass.
# errexit would abort at the first non-zero return -- e.g. check_ostree_remote
# failing would skip check_overlays, check_maivin_target, check_sd, etc. entirely,
# turning a full report into a whack-a-mole "fix one, rerun to see the next"
# loop. Confirmed by reproduction: with set -e, only the first FAIL: line
# ever printed.
set -u

PLATFORM="maivin-2"
SD_CARD=0
FIX=0
FAILED=0

usage() {
    cat <<'EOF'
Usage: maivin-provision [--fix] [--platform maivin-1|maivin-2|raivin]
                         [--sd-card]

Check (default) or fix remaining per-unit provisioning. Exit 0 only when
every requested check passes.

maivin.target must be enabled and active (fix: systemctl enable --now).
It never needs to be the *system default* target -- its own [Install] is
WantedBy=multi-user.target, so it activates alongside the normal default.
raivin.target still exists as a symlink to maivin.target for legacy
compatibility and will eventually be removed -- this tool never sets
either target as default, and nothing should.

  --fix              apply missing configuration
  --platform maivin-1|maivin-2|raivin
                     require /etc/overlays.txt to match this hardware
                     (fix: (re)writes it and runs update-overlays, which
                     reboots if the content changed). maivin-2 is the
                     default hardware and what maivin-etc-defaults.conf
                     seeds unattended; pass maivin-1 only for that older
                     AR0521 carrier. raivin uses the same overlays as
                     maivin-2 (same camera) and additionally requires
                     radarpub.service enabled (fix: systemctl enable --now)
                     and the ethernet1-radar NM connection actually pointed
                     at ethernet1 (fix: nmcli modify + up, then restart
                     radarpub -- a live mismatch here has been seen on real
                     hardware and silently breaks radar connectivity despite
                     the link itself showing up). fusion.service is never
                     touched by this flag or by --fix -- enabling it stays
                     a manual decision.
  --sd-card          require LABEL=DATA mounted at /media/DATA
EOF
}

fail() {
    echo "FAIL: $*" >&2
    FAILED=1
}

ok() {
    echo "OK: $*"
}

check_ostree_remote() {
    if [ ! -f /etc/ostree/remotes.d/maivin.conf ]; then
        if [ "$FIX" -eq 1 ] && [ -f /usr/etc/ostree/remotes.d/maivin.conf ]; then
            install -d /etc/ostree/remotes.d
            cp -a /usr/etc/ostree/remotes.d/maivin.conf /etc/ostree/remotes.d/maivin.conf
            ok "copied maivin OSTree remote from /usr/etc"
            return 0
        fi
        fail "missing /etc/ostree/remotes.d/maivin.conf"
        return 1
    fi
    ok "OSTree remote maivin.conf present"
}

check_ostree_origin() {
    origin=$(ostree admin status 2>/dev/null | awk '/origin refspec:/ {print $3; exit}')
    case "$origin" in
        maivin:*)
            ok "OSTree origin is $origin"
            ;;
        *)
            fail "OSTree origin is '${origin:-unset}'; expected maivin:... (redeploy with maivin: prefix)"
            ;;
    esac
}

# Echoes the expected /etc/overlays.txt content for a --platform value.
# raivin shares maivin-2's overlays: same carrier generation and camera,
# the only Raivin-specific requirement is radarpub (see check_radarpub).
overlays_for_platform() {
    case "$1" in
        maivin-1) echo "fdt_overlays=maivin1.dtbo maivin1-ar0521.dtbo" ;;
        maivin-2|raivin) echo "fdt_overlays=maivin2.dtbo maivin2-os08a20.dtbo" ;;
    esac
}

check_overlays() {
    expected=$(overlays_for_platform "$PLATFORM")
    current=""
    [ -f /etc/overlays.txt ] && current=$(cat /etc/overlays.txt)

    if [ "$current" = "$expected" ]; then
        ok "/etc/overlays.txt matches platform $PLATFORM"
    elif [ "$FIX" -eq 1 ]; then
        echo "$expected" > /etc/overlays.txt
        ok "wrote /etc/overlays.txt for platform $PLATFORM"
    else
        fail "/etc/overlays.txt does not match platform $PLATFORM (expected '$expected', got '${current:-missing}')"
    fi

    if [ "$FIX" -eq 1 ]; then
        systemctl start update-overlays.service || fail "update-overlays.service failed"
    fi
    if systemctl is-failed update-overlays.service >/dev/null 2>&1; then
        fail "update-overlays.service is failed"
    else
        ok "update-overlays.service is not failed"
    fi
}

check_radarpub() {
    [ "$PLATFORM" = "raivin" ] || return 0
    if systemctl is-enabled radarpub.service >/dev/null 2>&1; then
        ok "radarpub.service is enabled"
    elif [ "$FIX" -eq 1 ]; then
        systemctl enable --now radarpub.service
        ok "enabled and started radarpub.service"
    else
        fail "radarpub.service is not enabled (platform raivin)"
    fi
}

check_ethernet1_radar() {
    [ "$PLATFORM" = "raivin" ] || return 0
    current=$(nmcli -g connection.interface-name connection show ethernet1-radar 2>/dev/null)
    if [ "$current" = "ethernet1" ]; then
        ok "ethernet1-radar connection targets ethernet1"
        return 0
    fi
    if [ -z "$current" ]; then
        fail "ethernet1-radar connection profile not found"
        return 1
    fi
    # The shipped profile has always said interface-name=ethernet1 (since
    # f0e566a) -- a live mismatch here is drift on this specific unit (e.g.
    # a hand-run `nmcli connection add`/`modify` that typed a connection
    # NAME, like the "network1" profile from the old manual networking
    # steps, into the interface-name field by mistake), not a stale image
    # default, so there's nothing to seed this from in /usr/etc. Confirmed
    # on real hardware: link was up (1 Gbps) but the address never applied
    # to ethernet1, so the radar at .11 was unreachable and cube UDP never
    # arrived. Restarting radarpub after the fix is required -- if it
    # already started against the dead connection it won't pick up the
    # corrected route on its own.
    if [ "$FIX" -eq 1 ]; then
        nmcli connection modify ethernet1-radar connection.interface-name ethernet1
        nmcli connection up ethernet1-radar
        systemctl restart radarpub.service 2>/dev/null || true
        ok "corrected ethernet1-radar interface-name to ethernet1, brought it up, restarted radarpub"
    else
        fail "ethernet1-radar connection.interface-name is '$current', expected ethernet1 (radar traffic on that LAN never arrives)"
    fi
}

check_nm_unmanaged() {
    conf=/etc/NetworkManager/conf.d/unmanaged.conf
    extra=$(find /etc/NetworkManager/conf.d -maxdepth 1 -type f ! -name unmanaged.conf 2>/dev/null || true)
    if [ ! -f "$conf" ]; then
        fail "missing $conf"
    else
        ok "NetworkManager unmanaged.conf present"
    fi
    if [ -n "$extra" ]; then
        fail "unexpected NetworkManager conf.d files: $extra"
    else
        ok "only unmanaged.conf in NetworkManager conf.d"
    fi
}

# NOT `systemctl get-default` == maivin.target. maivin.target's own
# [Install] is WantedBy=multi-user.target (see maivin_1.1.bb's comment) and
# ships SYSTEMD_AUTO_ENABLE=enable, so the intended, sufficient activation
# path is enabled+active alongside the *unchanged* system default -- it
# never needs to itself become the default target. Confirmed on real
# hardware (verdin-imx8mp-15141091): `get-default` reported multi-user.target
# while maivin.target and every service under it (camera, imu, model,
# navsat, radarpub, fusion) were enabled and active -- a fully healthy unit
# that an earlier version of this check flagged as failed. Never touch
# `systemctl set-default` here; raivin.target (legacy symlink, being
# removed) must especially never be set, and neither target needs to be.
#
# maivin.target's own unit file orders it After= every service it Wants=
# (camera, imu, model, ...), so it's reached last, as an "everything is up"
# checkpoint -- not first. Right after boot, there's a real window where
# SSH is already reachable and every individual service is already active,
# but this specific check still reports inactive because the target itself
# hasn't flipped yet. Seen directly: FAIL moments after reboot, PASS
# checking again seconds later with nothing else changed. Not a bug to
# chase -- if this fails right after a fresh boot/reboot, wait a few
# seconds and rerun before treating it as real.
check_maivin_target() {
    active=$(systemctl is-active maivin.target 2>/dev/null)
    enabled=$(systemctl is-enabled maivin.target 2>/dev/null)
    if [ "$active" = "active" ] && [ "$enabled" = "enabled" ]; then
        ok "maivin.target is enabled and active"
        return 0
    fi
    if [ "$FIX" -eq 1 ]; then
        systemctl enable --now maivin.target
        ok "enabled and started maivin.target"
        return 0
    fi
    fail "maivin.target is not enabled+active (is-active: ${active:-unknown}, is-enabled: ${enabled:-unknown})"
}

check_sd() {
    [ "$SD_CARD" -eq 1 ] || return 0
    if [ ! -b /dev/mmcblk1 ]; then
        fail "mmcblk1 not present"
        return 1
    fi
    if [ ! -e /dev/disk/by-label/DATA ]; then
        fail "no filesystem label DATA on SD card"
        return 1
    fi
    if findmnt /media/DATA >/dev/null 2>&1; then
        ok "/media/DATA is mounted"
    else
        if [ "$FIX" -eq 1 ]; then
            systemctl start var-rootdirs-media-DATA.mount || true
        fi
        if findmnt /media/DATA >/dev/null 2>&1; then
            ok "/media/DATA is mounted"
        else
            fail "/media/DATA is not mounted"
        fi
    fi
}

check_ethernet1_master() {
    [ "$PLATFORM" = "raivin" ] || return 0
    if systemctl is-failed ethernet1-master.service >/dev/null 2>&1; then
        fail "ethernet1-master.service is failed"
        return 1
    fi
    ok "ethernet1-master.service is not failed"
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --fix)
            FIX=1
            ;;
        --sd-card)
            SD_CARD=1
            ;;
        --platform)
            shift
            PLATFORM="${1:-}"
            case "$PLATFORM" in
                maivin-1|maivin-2|raivin) ;;
                *)
                    echo "maivin-provision: --platform must be maivin-1, maivin-2, or raivin" >&2
                    exit 2
                    ;;
            esac
            ;;
        *)
            echo "maivin-provision: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

check_ostree_remote
check_ostree_origin
check_overlays
check_radarpub
check_ethernet1_radar
check_nm_unmanaged
check_maivin_target
check_sd
check_ethernet1_master

if [ "$FAILED" -ne 0 ]; then
    echo "maivin-provision: one or more checks failed" >&2
    exit 1
fi
echo "maivin-provision: all checks passed"
exit 0
