#!/bin/sh
# Idempotent Maivin/Raivin provisioning checks (and optional fixes).
#
# Deliberately no `set -e`: each check_* function records failure via
# fail()/$FAILED and returns, so every check runs and every failure is
# reported in one pass instead of stopping at the first one.
set -u

PLATFORM="maivin-2"
SD_CARD=0
FIX=0
FAILED=0
PENDING=0

usage() {
    cat <<'EOF'
Usage: maivin-provision [--fix]
                         [--platform maivin-1-ar0521|maivin-1-os08a20|maivin-2|raivin|maivin-e1r]
                         [--sd-card]

Check (default) or fix remaining per-unit provisioning. Exit 0 only when
every requested check passes; exit 2 if nothing failed but something (e.g.
maivin.target right after boot) is still starting -- rerun shortly; exit 1
on a real failure.

maivin.target must be enabled and active (fix: systemctl enable --now).
It never needs to be the *system default* target -- its own [Install] is
WantedBy=multi-user.target, so it activates alongside the normal default.
raivin.target still exists as a symlink to maivin.target for legacy
compatibility and will eventually be removed -- this tool never sets
either target as default, and nothing should.

  --fix              apply missing configuration
  --platform maivin-1-ar0521|maivin-1-os08a20|maivin-2|raivin|maivin-e1r
                     require /etc/overlays.txt to match this hardware
                     (fix: (re)writes it and runs update-overlays, which
                     reboots if the content changed). maivin-2 is the
                     default hardware and what maivin-etc-defaults.conf
                     seeds unattended. maivin-1-ar0521 is the older
                     e-ConSystems camera module; maivin-1-os08a20 is the
                     shared-with-Maivin-2 sensor on the Maivin 1 carrier.
                     `maivin-1` (bare) is a deprecated alias for
                     maivin-1-ar0521. raivin uses the same overlays as
                     maivin-2 and additionally requires radarpub.service
                     enabled (fix: systemctl enable --now) and the
                     ethernet1-radar NM connection pointed at ethernet1
                     (fix: nmcli modify + up, then restart radarpub).
                     maivin-e1r also uses the same overlays as maivin-2
                     and additionally requires: radarpub.service disabled
                     (fix: systemctl disable --now); /etc/default/lidarpub
                     installed from the shipped maivin-e1r profile and
                     lidarpub.service enabled (fix: cp the profile,
                     systemctl enable --now); the ethernet1-lidar NM
                     connection active on ethernet1 (fix: nmcli up); and
                     /etc/default/fusion's RADAR_PCD_TOPIC, LIDAR_PCD_TOPIC,
                     BBOX3D_SRC and GRID_SRC set for LiDAR (fix: sed, then
                     restart fusion). An M.2 card (e.g. an NPU) is an
                     independent per-unit addition and never part of the
                     expected overlay list for any platform. fusion.service
                     and lidarpub's Ouster settings are never touched by
                     this flag or by --fix outside the maivin-e1r case
                     above -- fusion enablement and non-E1R sensor
                     configuration stay a manual decision.
  --sd-card          require LABEL=DATA mounted at /media/DATA
EOF
}

fail() {
    echo "FAIL: $*" >&2
    FAILED=1
}

ok() {
    echo "OK: $*"
}

starting() {
    echo "STARTING: $*"
    PENDING=1
}

check_ostree_remote() {
    if [ ! -f /etc/ostree/remotes.d/maivin.conf ]; then
        if [ "$FIX" -eq 1 ] && [ -f /usr/etc/ostree/remotes.d/maivin.conf ]; then
            install -d /etc/ostree/remotes.d
            cp -a /usr/etc/ostree/remotes.d/maivin.conf /etc/ostree/remotes.d/maivin.conf
            ok "copied maivin OSTree remote from /usr/etc"
            return 0
        fi
        fail "missing /etc/ostree/remotes.d/maivin.conf"
        return 1
    fi
    ok "OSTree remote maivin.conf present"
}

check_ostree_origin() {
    origin=$(ostree admin status 2>/dev/null | awk '/origin refspec:/ {print $3; exit}')
    case "$origin" in
        maivin:*)
            ok "OSTree origin is $origin"
            ;;
        *)
            fail "OSTree origin is '${origin:-unset}'; expected maivin:... (redeploy with maivin: prefix)"
            ;;
    esac
}

# Echoes the expected /etc/overlays.txt content for a --platform value.
# raivin and maivin-e1r share maivin-2's overlays -- the radar/LiDAR swap
# is a service-level change, not a DT overlay (see check_radarpub /
# check_lidarpub). An M.2 card is a separate, per-unit addition.
overlays_for_platform() {
    case "$1" in
        maivin-1-ar0521) echo "fdt_overlays=maivin1.dtbo maivin1-ar0521.dtbo" ;;
        maivin-1-os08a20) echo "fdt_overlays=maivin1.dtbo maivin1-os08a20.dtbo" ;;
        maivin-2|raivin|maivin-e1r) echo "fdt_overlays=maivin2.dtbo maivin2-os08a20.dtbo" ;;
    esac
}

check_overlays() {
    expected=$(overlays_for_platform "$PLATFORM")
    current=""
    [ -f /etc/overlays.txt ] && current=$(cat /etc/overlays.txt)

    if [ "$current" = "$expected" ]; then
        ok "/etc/overlays.txt matches platform $PLATFORM"
    elif [ "$FIX" -eq 1 ]; then
        echo "$expected" > /etc/overlays.txt
        ok "wrote /etc/overlays.txt for platform $PLATFORM"
    else
        fail "/etc/overlays.txt does not match platform $PLATFORM (expected '$expected', got '${current:-missing}')"
    fi

    if [ "$FIX" -eq 1 ]; then
        systemctl start update-overlays.service || fail "update-overlays.service failed"
    fi
    if systemctl is-failed update-overlays.service >/dev/null 2>&1; then
        fail "update-overlays.service is failed"
    else
        ok "update-overlays.service is not failed"
    fi
}

check_radarpub() {
    case "$PLATFORM" in
        raivin)
            if systemctl is-enabled radarpub.service >/dev/null 2>&1; then
                ok "radarpub.service is enabled"
            elif [ "$FIX" -eq 1 ]; then
                systemctl enable --now radarpub.service
                ok "enabled and started radarpub.service"
            else
                fail "radarpub.service is not enabled (platform raivin)"
            fi
            ;;
        maivin-e1r)
            if ! systemctl is-enabled radarpub.service >/dev/null 2>&1; then
                ok "radarpub.service is disabled"
            elif [ "$FIX" -eq 1 ]; then
                systemctl disable --now radarpub.service
                ok "disabled radarpub.service (platform maivin-e1r has no radar)"
            else
                fail "radarpub.service is enabled but platform maivin-e1r has no radar"
            fi
            ;;
    esac
}

# Read-only reference profile installed by edgefirst-lidarpub's bbappend.
LIDARPUB_E1R_PROFILE=/usr/share/maivin/lidarpub/maivin-e1r.default

check_lidarpub() {
    [ "$PLATFORM" = "maivin-e1r" ] || return 0

    if [ ! -f "$LIDARPUB_E1R_PROFILE" ]; then
        fail "missing $LIDARPUB_E1R_PROFILE"
    elif cmp -s "$LIDARPUB_E1R_PROFILE" /etc/default/lidarpub 2>/dev/null; then
        ok "/etc/default/lidarpub matches the maivin-e1r profile"
    elif [ "$FIX" -eq 1 ]; then
        cp "$LIDARPUB_E1R_PROFILE" /etc/default/lidarpub
        ok "installed the maivin-e1r lidarpub profile"
    else
        fail "/etc/default/lidarpub does not match the maivin-e1r profile"
    fi

    if systemctl is-enabled lidarpub.service >/dev/null 2>&1; then
        ok "lidarpub.service is enabled"
    elif [ "$FIX" -eq 1 ]; then
        systemctl enable --now lidarpub.service
        ok "enabled and started lidarpub.service"
    else
        fail "lidarpub.service is not enabled (platform maivin-e1r)"
    fi

    if [ "$FIX" -eq 1 ]; then
        systemctl restart lidarpub.service 2>/dev/null || true
    fi
}

check_ethernet1_lidar() {
    [ "$PLATFORM" = "maivin-e1r" ] || return 0
    if nmcli -g GENERAL.STATE connection show ethernet1-lidar 2>/dev/null | grep -qx activated; then
        ok "ethernet1-lidar connection is active"
        return 0
    fi
    if [ "$FIX" -eq 1 ]; then
        nmcli connection up ethernet1-lidar
        ok "brought up ethernet1-lidar connection"
    else
        fail "ethernet1-lidar connection is not active (platform maivin-e1r)"
    fi
}

# Reads KEY's value out of /etc/default/fusion, accepting both
# "KEY=value" and "KEY = \"value\"" spacing and stripping quotes. Last
# match wins.
fusion_var() {
    grep "^$1[[:space:]]*=" /etc/default/fusion 2>/dev/null | tail -n1 | \
        sed -e 's/^[^=]*=[[:space:]]*//' -e 's/^"//' -e 's/"[[:space:]]*$//'
}

# Only /etc/default/fusion's content -- never fusion.service's enablement.
check_fusion_sensor() {
    [ "$PLATFORM" = "maivin-e1r" ] || return 0
    if [ ! -f /etc/default/fusion ]; then
        fail "/etc/default/fusion is missing"
        return 1
    fi

    for pair in RADAR_PCD_TOPIC: LIDAR_PCD_TOPIC:lidar/points \
                BBOX3D_SRC:lidar GRID_SRC:lidar; do
        key="${pair%%:*}"
        expected="${pair#*:}"
        current=$(fusion_var "$key")
        if [ "$current" = "$expected" ]; then
            ok "/etc/default/fusion $key=\"$expected\""
        elif [ "$FIX" -eq 1 ]; then
            sed -i "s|^$key[[:space:]]*=.*|$key = \"$expected\"|" /etc/default/fusion
            ok "set /etc/default/fusion $key=\"$expected\""
        else
            fail "/etc/default/fusion $key is '$current', expected '$expected' (platform maivin-e1r)"
        fi
    done

    if [ "$FIX" -eq 1 ]; then
        systemctl restart fusion.service 2>/dev/null || true
    fi
}

check_ethernet1_radar() {
    [ "$PLATFORM" = "raivin" ] || return 0
    current=$(nmcli -g connection.interface-name connection show ethernet1-radar 2>/dev/null)
    if [ "$current" = "ethernet1" ]; then
        ok "ethernet1-radar connection targets ethernet1"
        return 0
    fi
    if [ -z "$current" ]; then
        fail "ethernet1-radar connection profile not found"
        return 1
    fi
    # A mismatch here is per-unit drift, not a stale image default -- the
    # shipped profile always targets ethernet1. radarpub is restarted
    # because it won't pick up a corrected route on its own.
    if [ "$FIX" -eq 1 ]; then
        nmcli connection modify ethernet1-radar connection.interface-name ethernet1
        nmcli connection up ethernet1-radar
        systemctl restart radarpub.service 2>/dev/null || true
        ok "corrected ethernet1-radar interface-name to ethernet1, brought it up, restarted radarpub"
    else
        fail "ethernet1-radar connection.interface-name is '$current', expected ethernet1 (radar traffic on that LAN never arrives)"
    fi
}

check_nm_unmanaged() {
    conf=/etc/NetworkManager/conf.d/unmanaged.conf
    extra=$(find /etc/NetworkManager/conf.d -maxdepth 1 -type f ! -name unmanaged.conf 2>/dev/null || true)
    if [ ! -f "$conf" ]; then
        fail "missing $conf"
    else
        ok "NetworkManager unmanaged.conf present"
    fi
    if [ -n "$extra" ]; then
        fail "unexpected NetworkManager conf.d files: $extra"
    else
        ok "only unmanaged.conf in NetworkManager conf.d"
    fi
}

# Not `systemctl get-default` -- maivin.target's [Install] is
# WantedBy=multi-user.target, so it activates alongside the unchanged
# system default and never needs to become the default target itself.
# Never touch `systemctl set-default` here.
check_maivin_target() {
    active=$(systemctl is-active maivin.target 2>/dev/null)
    enabled=$(systemctl is-enabled maivin.target 2>/dev/null)
    if [ "$active" = "active" ] && [ "$enabled" = "enabled" ]; then
        ok "maivin.target is enabled and active"
        return 0
    fi
    # maivin.target orders After= every service it Wants=, so right after
    # boot it can still be inactive while those services are already up.
    # Targets have no "activating" substate, so a queued start job is the
    # only way to tell "still starting" from "never going to start".
    if systemctl list-jobs --plain --no-legend 2>/dev/null | awk '{print $2}' | grep -qx maivin.target; then
        starting "maivin.target has a start job queued, waiting on its dependencies -- rerun shortly"
        return 0
    fi
    if [ "$FIX" -eq 1 ]; then
        systemctl enable --now maivin.target
        ok "enabled and started maivin.target"
        return 0
    fi
    fail "maivin.target is not enabled+active and no start job is queued (is-active: ${active:-unknown}, is-enabled: ${enabled:-unknown})"
}

check_sd() {
    [ "$SD_CARD" -eq 1 ] || return 0
    if [ ! -b /dev/mmcblk1 ]; then
        fail "mmcblk1 not present"
        return 1
    fi
    if [ ! -e /dev/disk/by-label/DATA ]; then
        fail "no filesystem label DATA on SD card"
        return 1
    fi
    if findmnt /media/DATA >/dev/null 2>&1; then
        ok "/media/DATA is mounted"
    else
        if [ "$FIX" -eq 1 ]; then
            systemctl start var-rootdirs-media-DATA.mount || true
        fi
        if findmnt /media/DATA >/dev/null 2>&1; then
            ok "/media/DATA is mounted"
        else
            fail "/media/DATA is not mounted"
        fi
    fi
}

check_ethernet1_master() {
    [ "$PLATFORM" = "raivin" ] || return 0
    if systemctl is-failed ethernet1-master.service >/dev/null 2>&1; then
        fail "ethernet1-master.service is failed"
        return 1
    fi
    ok "ethernet1-master.service is not failed"
}

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --fix)
            FIX=1
            ;;
        --sd-card)
            SD_CARD=1
            ;;
        --platform)
            shift
            PLATFORM="${1:-}"
            case "$PLATFORM" in
                # Deprecated alias predating the OS08A20 option -- kept for
                # scripts/docs that already say plain "maivin-1".
                maivin-1) PLATFORM="maivin-1-ar0521" ;;
                maivin-1-ar0521|maivin-1-os08a20|maivin-2|raivin|maivin-e1r) ;;
                *)
                    echo "maivin-provision: --platform must be maivin-1-ar0521, maivin-1-os08a20, maivin-2, raivin, or maivin-e1r" >&2
                    exit 2
                    ;;
            esac
            ;;
        *)
            echo "maivin-provision: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

check_ostree_remote
check_ostree_origin
check_overlays
check_radarpub
check_ethernet1_radar
check_lidarpub
check_ethernet1_lidar
check_fusion_sensor
check_nm_unmanaged
check_maivin_target
check_sd
check_ethernet1_master

if [ "$FAILED" -ne 0 ]; then
    echo "maivin-provision: one or more checks failed" >&2
    exit 1
fi
if [ "$PENDING" -ne 0 ]; then
    echo "maivin-provision: nothing failed, but something is still starting -- rerun shortly" >&2
    exit 2
fi
echo "maivin-provision: all checks passed"
exit 0
