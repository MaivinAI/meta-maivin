#!/bin/sh
# Format /dev/mmcblk1 as GPT + ext4 LABEL=DATA.
# Without --force, only a card with no partition table and no filesystem is
# formatted. --force reformats any SD card, destroying its contents.
set -eu

DISK=/dev/mmcblk1
PART=/dev/mmcblk1p1
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

if [ ! -b "$DISK" ]; then
    exit 0
fi

if [ "$FORCE" -eq 1 ]; then
    # mmcblk numbering is fixed by DT aliases; refuse anything but the SD slot.
    if [ "$(cat /sys/block/mmcblk1/device/type 2>/dev/null)" != "SD" ]; then
        echo "maivin-sd-format: $DISK is not an SD card, refusing to format" >&2
        exit 1
    fi
    systemctl stop var-rootdirs-media-DATA.mount 2>/dev/null || true
    for p in "$DISK"p*; do
        [ -b "$p" ] || continue
        findmnt -rn -o TARGET -S "$p" | while read -r t; do umount "$t"; done
        wipefs -a "$p"
    done
    wipefs -a "$DISK"
    udevadm settle || true
else
    pttype=$(blkid -o value -s PTTYPE "$DISK" 2>/dev/null || true)
    fstype=$(blkid -o value -s TYPE "$DISK" 2>/dev/null || true)
    if [ -n "$pttype" ] || [ -n "$fstype" ]; then
        exit 0
    fi
    if [ -b "$PART" ]; then
        exit 0
    fi
fi

echo "maivin-sd-format: formatting $DISK as GPT ext4 LABEL=DATA" >&2
parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart DATA ext4 0% 100%
# Wait for udev to create the partition node
i=0
while [ ! -b "$PART" ] && [ "$i" -lt 20 ]; do
    udevadm settle || true
    sleep 1
    i=$((i + 1))
done
if [ ! -b "$PART" ]; then
    echo "maivin-sd-format: $PART did not appear" >&2
    exit 1
fi

mkfs.ext4 -F -L DATA "$PART"
udevadm settle || true

install -d -m 0755 /media/DATA
chown torizon:torizon /media/DATA 2>/dev/null || true
systemctl start var-rootdirs-media-DATA.mount || true
chown torizon:torizon /media/DATA 2>/dev/null || true
