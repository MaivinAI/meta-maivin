#!/bin/sh
# Format /dev/mmcblk1 only when it has no partition table and no filesystem.
# Never touch a card that already has data.
set -eu

DISK=/dev/mmcblk1
PART=/dev/mmcblk1p1

if [ ! -b "$DISK" ]; then
    exit 0
fi

pttype=$(blkid -o value -s PTTYPE "$DISK" 2>/dev/null || true)
fstype=$(blkid -o value -s TYPE "$DISK" 2>/dev/null || true)
if [ -n "$pttype" ] || [ -n "$fstype" ]; then
    exit 0
fi

if [ -b "$PART" ]; then
    exit 0
fi

echo "maivin-sd-format: blank $DISK, creating GPT ext4 LABEL=DATA" >&2
parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart DATA ext4 0% 100%
# Wait for udev to create the partition node
i=0
while [ ! -b "$PART" ] && [ "$i" -lt 20 ]; do
    udevadm settle || true
            sleep 1
    i=$((i + 1))
done
if [ ! -b "$PART" ]; then
    echo "maivin-sd-format: $PART did not appear" >&2
    exit 1
fi

mkfs.ext4 -F -L DATA "$PART"
udevadm settle || true

install -d -m 0755 /media/DATA
chown torizon:torizon /media/DATA 2>/dev/null || true
systemctl start media-DATA.mount || true
chown torizon:torizon /media/DATA 2>/dev/null || true
