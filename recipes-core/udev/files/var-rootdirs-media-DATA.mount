[Unit]
Description=DATA SD card
DefaultDependencies=no
After=maivin-sd-format.service systemd-udevd.service
Before=local-fs.target
ConditionPathExists=/dev/disk/by-label/DATA

[Mount]
What=/dev/disk/by-label/DATA
# /media is a symlink to var/rootdirs/media on this platform's stateless
# rootfs (Torizon's DISTRO_FEATURES stateless-system); systemd's native
# .mount units require Where= to be the canonical, symlink-free path or
# refuse to load ("Mount path /media/DATA is not canonical") -- unlike the
# fstab generator, which resolves it. Confirmed failing on real hardware
# (verdin-imx8mp-15141091) with Where=/media/DATA. findmnt and tmpfiles'
# `d` lines both follow the symlink fine; only this unit type is strict.
Where=/var/rootdirs/media/DATA
Type=ext4
# nofail keeps a missing card from failing local-fs.target, but What= still
# makes systemd order this unit After= the auto-generated device unit for
# /dev/disk/by-label/DATA, and that ordering wait is NOT shortened by
# x-systemd.device-timeout= here -- that pseudo-option is only parsed by
# systemd-fstab-generator for /etc/fstab entries, and is a silent no-op on a
# native .mount unit like this one (confirmed on real hardware: a card-less
# boot sat on "Timed out waiting for device" for the default 90s). The real
# timeout lives on the device unit itself via the drop-in shipped alongside
# this file: dev-disk-by\x2dlabel-DATA.device.d/timeout.conf.
Options=defaults,nofail

[Install]
WantedBy=local-fs.target
